GADGETHUB_PORT = PORT;
SECRET_KEY = SECRET_KEY
GEMINI_API_KEY = GEMINI_API_KEY
GOOGLE_CLIENT_ID = GOOGLE_CLIENT_ID
BACKEND_URL = BACKEND_URL
FRONTEND_URL = FRONTEND_URL
ESEWA_MERCHANT_CODE = ESEWA_MERCHANT_CODE
ESEWA_SECRET_KEY = ESEWA_SECRET_KEY
ESEWA_PAYMENT_URL = ESEWA_PAYMENT_URL
ESEWA_STATUS_CHECK_URL = ESEWA_STATUS_CHECK_URL

# Access/refresh token lifetimes (defaults shown; safe to omit).
ACCESS_TOKEN_EXPIRES_IN = 15m
REFRESH_TOKEN_EXPIRES_DAYS = 30

# Login abuse protection (defaults shown; safe to omit).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS = 5
LOGIN_RATE_LIMIT_WINDOW_MINUTES = 15
ACCOUNT_LOCKOUT_MAX_ATTEMPTS = 5
ACCOUNT_LOCKOUT_MINUTES = 15
PASSWORD_RESET_EXPIRES_MINUTES = 10

# SMTP for password-reset emails. Leave unset in dev — the reset link is
# logged to the server console instead. For Gmail, use an App Password
# (not your account password): https://myaccount.google.com/apppasswords
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 587
SMTP_USER = SMTP_USER
SMTP_PASS = SMTP_PASS
SMTP_FROM = "GadgetHub <no-reply@gadgethub.local>"